# --------------------------------------------------
# Made in Heaven — Variables de Entorno (plantilla)
# --------------------------------------------------
# Copiar este archivo como `frontend/.env.local` y completar los valores.
# NUNCA subir `frontend/.env.local` con secretos a un repositorio público.
# Ejemplo: cp frontend/.env.local.example frontend/.env.local
# --------------------------------------------------

# ----------------- Supabase (DB + Auth) -----------------
# Valores públicos (usados en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...paste_public_anon_key_here...

# Server-only (SERVICE ROLE KEY) — SOLO EN SERVIDOR
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here

# ----------------- WhatsApp -----------------
# Número en formato internacional sin el signo + (ej: 573249207921)
NEXT_PUBLIC_WA_NUMBER=573249207921

# ----------------- Instagram (opcional) -----------------
NEXT_PUBLIC_IG_USERNAME=madeinheaven.shop_

# ----------------- reCAPTCHA v3 (opcional) -----------------
# Obtener claves en https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ----------------- Wompi (Pagos) -----------------
# Public key (frontend / hosted checkout)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_stagtest_xxx

# Privadas — SOLO EN SERVIDOR
WOMPI_PRIVATE_KEY=prv_stagtest_xxx
WOMPI_EVENTS_SECRET=your_wompi_events_secret_here
WOMPI_INTEGRITY_SECRET=your_wompi_integrity_secret_here

# ----------------- App / Site -----------------
# URL pública usada para construir redirects (sin slash final)
NEXT_PUBLIC_SITE_URL=https://madeinheavenco.com

# ----------------- Admin (panel) -----------------
# Solo para entornos locales si no usas provider externo.
# En producción, inyectar por la plataforma de despliegue.
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# ----------------- Entorno -----------------
NODE_ENV=development

# ----------------- Notas importantes -----------------
# - Mantén las claves sensibles (SERVICE_ROLE_KEY, WOMPI_PRIVATE_KEY,
#   WOMPI_EVENTS_SECRET, etc.) SOLO en variables de entorno del servidor.
# - Al rotar claves, actualiza también la configuración de webhooks en Wompi.
# - En Vercel/GCP/AWS, añade estas variables en la sección de Environment Variables
#   en lugar de subir un .env con valores reales.
