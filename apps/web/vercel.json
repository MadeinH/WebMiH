{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",

  "regions": ["gru1"],

  "functions": {
    "app/api/**/*.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },

  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],

  "cleanUrls": true,
  "trailingSlash": false
}
